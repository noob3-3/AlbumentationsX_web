# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Backend data (exclude model weights and large files)
backend/data/uploads/
backend/data/datasets/
backend/data/augmented/
backend/data/models/
backend/data/exports/
backend/logs/
backend/data/*.db

# Keep .gitkeep placeholder files
!backend/data/**/.gitkeep

# Project root local data (mapped from Docker containers)
# 📤 Uploaded files
data/uploads/
# 📁 Datasets
data/datasets/
# ✨ Augmented data
data/augmented/
# 🤖 Trained models
data/models/
# 📊 Training exports
data/exports/
# 🗄️ Database
data/*.db
# 📝 Logs
logs/

# Keep directory structure with .gitkeep files
!data/**/.gitkeep
!logs/.gitkeep

# Alembic versions (optional: track these)
# backend/alembic/versions/

# Docs (VitePress)
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Environment
.env.local
*.env.local

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# YOLO runs
runs/

# Offline license (do not commit activated keys)
license.dat
backend/license.dat

# Desktop / PyInstaller output
packaging/dist/
packaging/build/
packaging/*.pyc
packaging/*.7z
packaging/vc_redist.x64.exe
packaging/vc_runtime_dlls/
packaging/win7_c10_hotfix/*.dll
packaging/exe-stdout.txt
