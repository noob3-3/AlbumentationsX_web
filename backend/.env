# Application Settings
APP_NAME=AlbumentationsX Training Platform
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS Origins - 内网使用，允许所有源
ALLOWED_ORIGINS=["*"]

# Database
DATABASE_URL=sqlite:///./data/app.db

# Client API Token - CHANGE THIS IN PRODUCTION!
CLIENT_API_TOKEN=your-secret-token-change-this

# Default Training Parameters
DEFAULT_EPOCHS=100
DEFAULT_BATCH_SIZE=16
DEFAULT_IMG_SIZE=640
DEFAULT_MODEL=yolo11n.pt
