# ╔══════════════════════════════════════════════════════════════╗
# ║  AlbumentationsX Training Platform — GPU All-in-one         ║
# ║  Multi-stage: frontend build → GPU Python runtime           ║
# ║  Run from project root: docker build -f backend/Dockerfile.gpu -t axweb-gpu . ║
# ╚══════════════════════════════════════════════════════════════╝

# ─────────────────────────────────────────────
# Stage 1: Build Vue3 + Vite frontend
# ─────────────────────────────────────────────
FROM node:20-alpine AS frontend-builder

WORKDIR /frontend

# Cache npm install layer separately
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install --prefer-offline

# Build production bundle
COPY frontend/ .
RUN npm run build
# Artifacts at /frontend/dist/


# ─────────────────────────────────────────────
# Stage 2: GPU Runtime with CUDA support
# Based on NVIDIA CUDA + Ultralytics official image
# Reference: https://docs.ultralytics.com/guides/docker-quickstart/
# ─────────────────────────────────────────────
FROM ultralytics/ultralytics:latest

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*




# 卸载基础镜像自带的 torch（避免版本冲突）
RUN pip uninstall torch torchvision torchaudio -y --no-cache-dir || true

# Copy requirements first (for better caching)
# Use requirements-gpu.txt which excludes ultralytics (already in base image)
COPY backend/requirements-gpu.txt ./requirements.txt

# 1) 先装应用依赖（numpy<2 已在 requirements 中）
RUN pip install --no-cache-dir -r requirements.txt

# 2) 升级 Ultralytics（其依赖 torch>=1.8、numpy>=1.23 无上限，可能拉高 numpy 或 torch）
RUN pip install --no-cache-dir -U "ultralytics>=8.4.23"

# 3) 最后强制安装指定版本，覆盖任何被依赖解析改动的包
#    - PyTorch 2.2.2 + CUDA 11.8（国内镜像）
#    - NumPy 1.x（2.2.2 与 NumPy 2.x 不兼容，ultralytics 会拉 numpy 2.x）
RUN pip install --no-cache-dir --force-reinstall \
    torch==2.2.2 torchvision==0.17.2 torchaudio==2.2.2 \
    "numpy>=1.26.0,<2" \
    -f https://mirrors.aliyun.com/pytorch-wheels/cu118

# Copy application code
COPY backend/ .

# ── Copy built frontend static files ─────────
# FastAPI will serve these under "/" via StaticFiles
COPY --from=frontend-builder /frontend/dist /app/static

# Create necessary directories
# Set permissions to 777 to allow both host and container to read/write
RUN mkdir -p \
    data/uploads \
    data/static-file \
    data/augmented \
    data/models \
    data/exports \
    logs && \
    chmod -R 777 data logs && \
    chmod +x start.sh

# ── Python environment ────────────────────────
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    STATIC_DIR=/app/static \
    TZ=Asia/Shanghai

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run database migrations and start server
CMD ["./start.sh"]
